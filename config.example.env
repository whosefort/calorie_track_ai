# Этот файл — только пример. Настоящий конфиг setup сохранит в
# /etc/calories-bot/calories-bot.env, вне git-репозитория.
TELEGRAM_TOKEN=
# polling — простой режим по умолчанию: без домена, Caddy и входящих портов.
# webhook — нужен домен с HTTPS; setup сам создаст WEBHOOK_SECRET.
TELEGRAM_MODE=polling
ALLOWED_USERS=
MAX_REQUESTS_PER_DAY=20

# Значение ключа — только сам ключ, без `Bearer `, кавычек и `export`.
# setup принимает ключ как обычную строку и сам записывает конфиг с правами 600.
# Любой OpenAI-compatible API: OpenAI, OpenRouter, Gemini, vLLM, Ollama, свой шлюз.
# Рабочий вариант по умолчанию: Gemini API напрямую.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# auto = JSON Schema с безопасным fallback; strict = только JSON Schema.
LLM_STRUCTURED_OUTPUT=auto
AI_TIMEOUT=20
# Оставь пустым для максимальной совместимости с reasoning-моделями. Укажи 0
# только для API, которое поддерживает параметр temperature.
LLM_TEMPERATURE=
# Необязательная инструкция владельца. Оставь пустой для максимальной точности:
# встроенный шаблон уже задаёт роль, формат и проверку итогов.
LLM_SYSTEM_PROMPT=

# Не меняй без необходимости: deploy создаёт каталог и резервную копию БД.
DATABASE_PATH=/var/lib/calories-bot/calories.sqlite3

# Только для TELEGRAM_MODE=webhook:
# WEBHOOK_SECRET=setup_сгенерирует_сам
# BOT_DOMAIN=bot.example.com

# Пример OpenRouter (вставлять эти четыре строки в реальный конфиг, без #):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
# LLM_MODEL=~openai/gpt-latest
# LLM_STRUCTURED_OUTPUT=auto

# Пример Gemini API напрямую (ключ из Google AI Studio):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza_REPLACE_WITH_YOUR_KEY
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_STRUCTURED_OUTPUT=auto
